{
  "name": "qr-restaurant-saas",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.0",
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm --workspace=@qr-restaurant/shared run build",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:backend": "npm run build -w @qr-restaurant/shared && npm run build -w @qr-restaurant/server",
    "start:backend": "npm run start -w @qr-restaurant/server",
    "build:frontend": "npm run build -w @qr-restaurant/shared && npm run build -w @qr-restaurant/web",
    "start:frontend": "npm run start -w @qr-restaurant/web",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
